# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Cohttp-eio adapter for sigv4 (AWS container credentials provider)"
description: """
Wires Sigv4.Credentials.handler to the AWS container credentials endpoint
(ECS link-local) using a cohttp-eio client, with a dummy fallback for local
development. Kept separate from the core sigv4 package so that callers that
only need signing do not pull in eio and cohttp."""
maintainer: ["Yuki Tajiri"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/sigv4.ml"
bug-reports: "https://github.com/lmdexpr/sigv4.ml/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.23"}
  "sigv4" {= version}
  "eio"
  "cohttp-eio"
  "uri"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/sigv4.ml.git"
x-maintenance-intent: ["(latest)"]
